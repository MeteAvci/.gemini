{
  "artifactReviewPolicy": "agent-decides",
  "enableTerminalSandbox": true,
  "notifications": true,
  "permissions": {
    "allow": [
      "command(git status)",
      "command(git diff)",
      "command(git log)",
      "command(git show)",
      "command(git rev-parse)",
      "command(git branch)",
      "command(rg)",
      "command(pytest)",
      "command(python -m pytest)",
      "command(python3 -m pytest)",
      "command(python -m unittest)",
      "command(python3 -m unittest)",
      "command(npm test)",
      "command(npm run test)",
      "command(npm run lint)",
      "command(npm run typecheck)",
      "command(pnpm test)",
      "command(cargo test)",
      "command(cargo check)"
    ],
    "deny": [
      "command(git reset --hard)",
      "command(git clean -fdx)",
      "command(git push --force)",
      "command(rm -rf)",
      "command(del /f)",
      "command(sudo)",
      "command(su )",
      "command(powershell -ExecutionPolicy Bypass)",
      "command(pwsh -ExecutionPolicy Bypass)"
    ],
    "ask": [
      "command(npm install)",
      "command(npm add)",
      "command(pnpm install)",
      "command(pnpm add)",
      "command(yarn add)",
      "command(pip install)",
      "command(pip3 install)",
      "command(cargo add)",
      "read_url(*)",
      "execute_url(*)"
    ]
  },
  "showFeedbackSurvey": false,
  "showTips": false,
  "toolPermission": "proceed-in-sandbox",
  "trustedWorkspaces": [],
  "verbosity": "medium"
}
