{
  "mcpServers": {
    "gdp": {
      "command": "gdp",
      "args": [
        "mcp-stdio"
      ],
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUTF8": "1"
      }
    },
    "gdp-global": {
      "command": "gdp",
      "args": [
        "mcp-stdio",
        "--gateway"
      ],
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUTF8": "1"
      }
    }
  }
}
