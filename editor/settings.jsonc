{
  // =========================================================================
  // VS Code / Antigravity Editor Settings (v2.0)
  // Cleanly decoupled from Gemini CLI runtime settings
  // =========================================================================

  // ---------------------------------------------------------------
  // Windows terminal: clean PowerShell 7
  // ---------------------------------------------------------------
  "terminal.integrated.profiles.windows": {
    "GDP PowerShell": {
      "path": "pwsh.exe",
      "args": [
        "-NoLogo",
        "-NoProfile"
      ]
    }
  },
  "terminal.integrated.defaultProfile.windows": "GDP PowerShell",

  // No -ExecutionPolicy Bypass.
  // Shell integration is kept intact instead of disabling editor features
  "terminal.integrated.shellIntegration.enabled": true,
  "terminal.integrated.gpuAcceleration": "auto",

  // ---------------------------------------------------------------
  // Save semantics (Race Condition Prevention)
  // ---------------------------------------------------------------
  "files.autoSave": "onFocusChange",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,

  // ---------------------------------------------------------------
  // TypeScript / JavaScript diagnostics
  // ---------------------------------------------------------------
  "typescript.tsserver.experimental.enableProjectDiagnostics": true,
  "typescript.tsserver.maxTsServerMemory": 4096,
  "typescript.disableAutomaticTypeAcquisition": false,

  // ---------------------------------------------------------------
  // Python / Pyright-backed diagnostics
  // ---------------------------------------------------------------
  "python.analysis.indexing": true,
  "python.analysis.autoImportCompletions": true,
  "python.analysis.diagnosticMode": "workspace",
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.exclude": [
    "**/.venv/**",
    "**/venv/**",
    "**/__pycache__/**",
    "**/.pytest_cache/**",
    "**/.mypy_cache/**",
    "**/.ruff_cache/**",
    "**/.tox/**",
    "**/.nox/**"
  ],

  // ---------------------------------------------------------------
  // Watcher CPU / filesystem pressure (CPU Saver)
  // ---------------------------------------------------------------
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/.git/lfs/**": true,
    "**/node_modules/**": true,
    "**/.pnpm-store/**": true,
    "**/.yarn/cache/**": true,
    "**/.npm/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/coverage/**": true,
    "**/.turbo/**": true,
    "**/.cache/**": true,
    "**/.parcel-cache/**": true,
    "**/.vite/**": true,
    "**/.next/**": true,
    "**/.nuxt/**": true,
    "**/.svelte-kit/**": true,
    "**/.astro/**": true,
    "**/.angular/**": true,
    "**/.vercel/**": true,
    "**/__pycache__/**": true,
    "**/.pytest_cache/**": true,
    "**/.mypy_cache/**": true,
    "**/.ruff_cache/**": true,
    "**/.venv/**": true,
    "**/venv/**": true,
    "**/target/**": true,
    "**/.gradle/**": true,
    "**/Pods/**": true,
    "**/.dart_tool/**": true,
    "**/.flutter-plugins/**": true,
    "**/bin/**": true,
    "**/obj/**": true,
    "**/.idea/**": true,
    "**/.vscode-test/**": true
  },

  // ---------------------------------------------------------------
  // Search noise (NOTE: lockfiles intentionally remain searchable)
  // ---------------------------------------------------------------
  "search.exclude": {
    "**/node_modules": true,
    "**/.pnpm-store": true,
    "**/dist": true,
    "**/build": true,
    "**/coverage": true,
    "**/.next": true,
    "**/.nuxt": true,
    "**/.turbo": true,
    "**/*.map": true,
    "**/*.min.js": true,
    "**/*.min.css": true
  },

  // ---------------------------------------------------------------
  // Low-noise UI
  // ---------------------------------------------------------------
  "editor.minimap.enabled": false,
  "editor.codeLens": false,
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": true,
  "editor.guides.indentation": true,
  "workbench.reduceMotion": "on"
}
