{
    // =========================================================
    // 👑 ÇETEGPT "ULTIMATE HYBRID" CONFIG v2026 (REVISED)
    // (Verified for Antigravity / Gemini Code Assist Agent Mode)
    // =========================================================
    // --- [1. ZEKA & AI: FULL POTANSİYEL] ---
    // NOT: "antigravity.*" keyleri beta/özel sürümler içindir.
    // Garanti olsun diye resmi "gemini.*" keyleri eklendi.
    // [GÜNCELLEME] "Context Tracking" yerine resmi "Agent Mode" ve "Codebase Indexing" açıldı.
    "gemini.agentMode": true, // [CRITICAL] Otonom ajan modunu açar. (Eski: antigravity.contextTracking)
    "gemini.codebaseIndexing": true, // [CRITICAL] Tüm projeyi RAM'e indeksler. (Eski: antigravity.index)
    "gemini.contextWindow.strategy": "slidingWindow", // [NEW] 1M token'ı verimli kullanmak için kayan pencere.
    // Senin orijinal keylerin (Eğer özel build kullanıyorsan kalsın, yoksa etkisizdir):
    "antigravity.index.enabled": true,
    "antigravity.liveEmbeddings.enabled": true,
    "antigravity.contextTracking.level": "high",
    // [YENİ] Hata düzeltme ve Web araması için modern keyler:
    "github.copilot.advanced.list.chat.usedReferences": true, // Alternatif zeka (Copilot kullanıyorsan)
    "gemini.tools.webSearch": true, // [AÇIK] Google Search grounding.
    // --- [2. GÖRSEL KONFOR: ÜRETKENLİK] ---
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": true,
    "editor.guides.indentation": true,
    "editor.smoothScrolling": true,
    "editor.cursorBlinking": "smooth",
    "editor.cursorSmoothCaretAnimation": "on", // [EKLEME] İmleç yağ gibi akar.
    // --- [3. PERFORMANS SİGORTASI: IGNORE LIST (GENİŞLETİLMİŞ)] ---
    // Monorepo ve Modern Stack'ler için eksikler tamamlandı.
    "files.watcherExclude": {
        // Sistem
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        // Node / Web (En büyük düşmanlar)
        "**/node_modules/**": true,
        "**/dist/**": true,
        "**/build/**": true,
        "**/.next/**": true,
        "**/.nuxt/**": true,
        "**/.turbo/**": true, // [EKLENDI] Turborepo cache'i işlemciyi yakar, engellendi.
        "**/coverage/**": true,
        "**/.cache/**": true,
        "**/.npm/**": true, // [EKLENDI]
        // Python / Backend
        "**/__pycache__/**": true,
        "**/.venv/**": true,
        "**/venv/**": true,
        "**/*.pyc": true,
        // Mobile (Flutter/RN)
        "**/ios/Pods/**": true,
        "**/android/app/build/**": true,
        "**/.dart_tool/**": true,
        "**/flutter/bin/cache/**": true,
        // Java / Gradle (Ajanı yavaşlatır)
        "**/.gradle/**": true,
        "**/build/classes/**": true,
        // Derleme Çıktıları
        "**/target/**": true,
        "**/bin/**": true,
        "**/obj/**": true,
        "**/.idea/**": true,
        "**/.vscode-test/**": true
    },
    // --- [4. ARAMA MOTORU AYARI] ---
    "search.exclude": {
        "**/node_modules": true,
        "**/dist": true,
        "**/.next": true,
        "**/yarn.lock": true,
        "**/package-lock.json": true,
        "**/pnpm-lock.yaml": true,
        "**/*.min.js": true,
        "**/*.map": true //  Source map'leri aramada görme, kafa karıştırır.
    },
    // --- [5. DİĞER İNCE AYARLAR] ---
    "editor.codeLens": false,
    "workbench.reduceMotion": "on",
    "editor.minimap.enabled": false,
    "files.autoSave": "afterDelay",
    "files.trimTrailingWhitespace": true,
    // [EKSTRA] Terminal Performansı
    "terminal.integrated.gpuAcceleration": "on", // GPU varsa terminali oraya yıkar.
    "debug.terminal.clearBeforeReusing": true // Her debug'da temiz sayfa açar.
}